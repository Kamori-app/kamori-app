{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "bun.lock",
    "package.json",
    "bunfig.toml",
    "Cargo.toml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/.gitkeep"],
      "outputs": [
        "dist/**",
        "build/**",
        ".svelte-kit/**",
        "pkg/**"
      ]
    },
    "cloud-server#build": {
      "cache": false,
      "outputs": []
    },
    "crypto-core-lib#build": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "cloud-server#test": {
      "dependsOn": ["^test"],
      "cache": false,
      "passThroughEnv": ["KAMORI_DATABASE_URL", "DATABASE_URL"]
    },
    "fast": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "dav-bridge-desktop#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/acceptance/ui-gates.config.ts",
        "$TURBO_ROOT$/tests/acceptance/specs/uiHost.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/uiGates.bundle.mjs",
        "$TURBO_ROOT$/tests/acceptance/package.json",
        "$TURBO_ROOT$/tests/acceptance/specs/desktop-ui.spec.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/desktopUi.js",
        "$TURBO_ROOT$/tests/acceptance/specs/invite-ui.spec.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/inviteUi.js",
        "$TURBO_ROOT$/apps/web-frontend/src/**",
        "$TURBO_ROOT$/apps/web-frontend/package.json"
      ]
    },
    "admin-frontend#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/acceptance/ui-gates.config.ts",
        "$TURBO_ROOT$/tests/acceptance/specs/uiHost.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/uiGates.bundle.mjs",
        "$TURBO_ROOT$/tests/acceptance/package.json",
        "$TURBO_ROOT$/tests/acceptance/specs/admin-ui.spec.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/adminUi.js"
      ]
    }
  }
}
