{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "bun.lock",
    "package.json",
    "bunfig.toml",
    "Cargo.toml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "target/**", "pkg/**", ".turbo/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "fast": {
      "outputs": []
    },
    "format": {
      "outputs": []
    }
  }
}
