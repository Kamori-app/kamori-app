{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "bun.lock",
    "package.json",
    "bunfig.toml",
    "Cargo.toml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/.gitkeep"],
      "outputs": [
        "dist/**",
        "build/**",
        ".svelte-kit/**",
        "pkg/**"
      ]
    },
    "cloud-server#build": {
      "cache": false,
      "outputs": []
    },
    "crypto-core-lib#build": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "cloud-server#test": {
      "dependsOn": ["^test"],
      "cache": false,
      "passThroughEnv": ["KAMORI_DATABASE_URL", "DATABASE_URL"]
    },
    "fast": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "dav-bridge-desktop#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/acceptance/ui-gates.config.ts",
        "$TURBO_ROOT$/tests/acceptance/specs/uiHost.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/uiGates.bundle.mjs",
        "$TURBO_ROOT$/tests/acceptance/package.json",
        "$TURBO_ROOT$/tests/acceptance/specs/desktop-ui.spec.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/desktopUi.js",
        "$TURBO_ROOT$/tests/acceptance/specs/invite-ui.spec.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/inviteUi.js",
        "$TURBO_ROOT$/apps/web-frontend/src/**",
        "$TURBO_ROOT$/apps/web-frontend/package.json"
      ]
    },
    "admin-frontend#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/acceptance/ui-gates.config.ts",
        "$TURBO_ROOT$/tests/acceptance/specs/uiHost.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/uiGates.bundle.mjs",
        "$TURBO_ROOT$/tests/acceptance/package.json",
        "$TURBO_ROOT$/tests/acceptance/specs/admin-ui.spec.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/adminUi.js"
      ]
    },
    "crypto-core-lib#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/fixtures/pim/**"
      ]
    },
    "dav-bridge-mobile#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/fixtures/pim/**"
      ]
    },
    "web-frontend#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/.gitkeep",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/config",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/apps/**/Cargo.toml",
        "$TURBO_ROOT$/packages/**/Cargo.toml",
        "$TURBO_ROOT$/packages/crypto-core-lib/src/**/*.rs",
        "$TURBO_ROOT$/packages/crypto-core-lib/build.rs",
        "$TURBO_ROOT$/scripts/web-crypto-wasm.mjs"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".svelte-kit/**",
        "pkg/**"
      ]
    },
    "web-frontend#lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/config",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/apps/**/Cargo.toml",
        "$TURBO_ROOT$/packages/**/Cargo.toml",
        "$TURBO_ROOT$/packages/crypto-core-lib/src/**/*.rs",
        "$TURBO_ROOT$/packages/crypto-core-lib/build.rs",
        "$TURBO_ROOT$/scripts/web-crypto-wasm.mjs"
      ],
      "outputs": []
    },
    "web-frontend#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/fixtures/pim/**",
        "$TURBO_ROOT$/tests/acceptance/ui-gates.config.ts",
        "$TURBO_ROOT$/tests/acceptance/package.json",
        "$TURBO_ROOT$/tests/acceptance/specs/pim-recurrence.spec.ts",
        "$TURBO_ROOT$/tests/acceptance/fixtures/calendarCorpus.js",
        "$TURBO_ROOT$/tests/acceptance/fixtures/taskEditor.bundle.mjs",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/config",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/apps/**/Cargo.toml",
        "$TURBO_ROOT$/packages/**/Cargo.toml",
        "$TURBO_ROOT$/packages/crypto-core-lib/src/**/*.rs",
        "$TURBO_ROOT$/packages/crypto-core-lib/build.rs",
        "$TURBO_ROOT$/scripts/web-crypto-wasm.mjs"
      ]
    }
  }
}
