# Example env overrides for local web testing over HTTP (no TLS).
# Keep production defaults (`Secure` + `__Host-` cookies) outside local dev.

KAMORI_CORS_ALLOW_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174
KAMORI_CORS_ALLOW_CREDENTIALS=true
KAMORI_WEBAUTHN_RP_ID=localhost
KAMORI_WEBAUTHN_RP_ORIGIN=http://localhost:4173
KAMORI_WEBAUTHN_RP_NAME=Kamori
KAMORI_ADMIN_WEBAUTHN_RP_ORIGIN=http://localhost:4174
KAMORI_ADMIN_WEBAUTHN_RP_NAME=Kamori Admin

KAMORI_WEB_REFRESH_COOKIE_SECURE=false
KAMORI_WEB_REFRESH_COOKIE_NAME=kamori_rt
KAMORI_WEB_CSRF_COOKIE_NAME=kamori_csrf

# Local MinIO example. Create the private `kamori-local` bucket first.
KAMORI_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
KAMORI_OBJECT_STORE_REGION=us-east-1
KAMORI_OBJECT_STORE_BUCKET=kamori-local
KAMORI_OBJECT_STORE_ACCESS_KEY_ID=local-minio-key
KAMORI_OBJECT_STORE_SECRET_ACCESS_KEY=local-minio-secret
KAMORI_OBJECT_STORE_ALLOW_HTTP=true
KAMORI_METRICS_BEARER_TOKEN=replace-with-at-least-32-random-bytes
