{
  "name": "admin-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "lint": "bun run check",
    "test:unit": "bun test src/lib",
    "test": "bun run check && bun run test:unit && bun run test:ui",
    "test:ui": "cd ../../tests/acceptance && env -u NO_COLOR KAMORI_UI_GATE=admin node node_modules/@playwright/test/cli.js test --config ui-gates.config.ts admin-ui.spec.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@sveltejs/kit": "^3.1.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript/native": "npm:typescript@7",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
