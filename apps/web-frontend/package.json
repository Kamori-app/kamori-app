{
  "name": "web-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "lint": "bun run check",
    "test:unit": "bun test src/lib",
    "test": "bun run check && bun run test:unit && bun run test:ui",
    "test:ui": "cd ../../tests/acceptance && env -u NO_COLOR KAMORI_UI_GATE=web node node_modules/@playwright/test/cli.js test --config ui-gates.config.ts pim-recurrence.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/ciphers": "^2.4.0",
    "@sveltejs/kit": "^3.1.0",
    "rrule": "^2.8.1",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@typescript/native": "npm:typescript@7",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
