{
  "name": "kamori",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "overrides": {
    "cookie": "0.7.2",
    "esbuild": "0.27.4",
    "nanoid": "3.3.18",
    "picomatch": "4.0.5",
    "postcss": "8.5.26",
    "vite": "8.2.2"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "fast": "turbo run fast --filter=cloud-server --filter=crypto-core-lib",
    "verify": "bun run lint && bun run test",
    "format": "turbo run format",
    "acceptance:up": "bash scripts/acceptance.sh up",
    "acceptance:down": "bash scripts/acceptance.sh down",
    "acceptance:reset": "bash scripts/acceptance.sh reset",
    "acceptance:logs": "bash scripts/acceptance.sh logs",
    "acceptance:smoke": "bash scripts/acceptance.sh smoke",
    "acceptance:full": "bash scripts/acceptance.sh full"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  }
}
