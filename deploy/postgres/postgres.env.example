# Shared node settings. Keep this file root-owned mode 0600.
POSTGRES_VERSION=16
POSTGRES_PRIMARY_IP=10.42.0.21
POSTGRES_STANDBY_ENABLED=false
# Required only when POSTGRES_STANDBY_ENABLED=true.
# POSTGRES_STANDBY_IP=10.42.0.22
# Must be the mounted protected Hetzner volume, never / or /var/lib/postgresql.
POSTGRES_DATA_DIR=/mnt/HC_Volume_REPLACE/postgresql/16/main

POSTGRES_APP_PASSWORD=REPLACE_RANDOM_PASSWORD
# Required only when POSTGRES_STANDBY_ENABLED=true.
# POSTGRES_REPLICATION_PASSWORD=REPLACE_RANDOM_PASSWORD
# This role can only upsert the operator heartbeat table.
POSTGRES_JOBS_PASSWORD=REPLACE_RANDOM_PASSWORD

# Dedicated bucket-scoped B2 key for the protected PostgreSQL backup bucket.
PGBACKREST_S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
PGBACKREST_S3_REGION=eu-central-003
PGBACKREST_S3_BUCKET=REPLACE_POSTGRES_BACKUP_BUCKET
PGBACKREST_S3_KEY_ID=REPLACE_BUCKET_SCOPED_KEY_ID
PGBACKREST_S3_APPLICATION_KEY=REPLACE_BUCKET_SCOPED_APPLICATION_KEY
PGBACKREST_CIPHER_PASS=REPLACE_RANDOM_BACKUP_ENCRYPTION_SECRET
