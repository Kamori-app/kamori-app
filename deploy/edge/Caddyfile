{
	auto_https off
	admin off
	servers {
		# Hetzner is the only public HTTP peer. Strict right-to-left parsing
		# preserves its client address without trusting values prepended by a
		# caller. The API repeats the same trust walk after the Docker hop.
		trusted_proxies static 10.42.0.5/32
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@api host api.kamori.app
	handle @api {
		reverse_proxy cloud:8080
	}

	@admin host admin.kamori.app
	handle @admin {
		header {
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		}
		reverse_proxy admin:3000
	}

	@web host kamori.app app.kamori.app
	handle @web {
		header {
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		}
		reverse_proxy web:3000
	}

	# Hetzner health checks do not guarantee an application Host header.
	handle /health/ready {
		reverse_proxy cloud:8080
	}

	# Prometheus reaches app nodes over the private network and authenticates at
	# the application metrics endpoint with its bearer token.
	handle /metrics {
		reverse_proxy cloud:8080
	}

	respond 404
}
