# Root-owned mode 0600 on the ops node.
PRIMARY_S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
PRIMARY_S3_REGION=eu-central-003
PRIMARY_S3_BUCKET=REPLACE_PRIMARY_BUCKET
PRIMARY_S3_KEY_ID=REPLACE_READ_ONLY_BUCKET_KEY_ID
PRIMARY_S3_APPLICATION_KEY=REPLACE_READ_ONLY_BUCKET_KEY

DR_S3_ENDPOINT=fsn1.your-objectstorage.com
DR_S3_REGION=fsn1
DR_S3_BUCKET=REPLACE_DR_BUCKET
DR_S3_ACCESS_KEY=REPLACE_WRITE_ONLY_BUCKET_KEY_ID
DR_S3_SECRET_KEY=REPLACE_WRITE_ONLY_BUCKET_KEY

# Restricted kamori_jobs role; TLS certificate has only this database identity.
JOBS_DATABASE_URL=postgres://kamori_jobs:REPLACE_URL_ENCODED_PASSWORD@10.42.0.21:5432/kamori?sslmode=verify-full&sslrootcert=/etc/kamori/tls/postgres-ca.crt&sslcert=/etc/kamori/tls/jobs-client.crt&sslkey=/etc/kamori/tls/jobs-client.key
BLOB_VERIFY_SAMPLE_COUNT=20
