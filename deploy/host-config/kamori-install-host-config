#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 || $# -ne 1 ]]; then
  echo "usage: kamori-install-host-config ROLE (as root)" >&2
  exit 2
fi

role=$1
case "$role" in
  app|ops|db-primary) ;;
  *) echo "unsupported host role: $role" >&2; exit 2 ;;
esac

installed_role=$(tr -d '\r\n' </etc/kamori/node-role)
if [[ "$installed_role" != "$role" ]]; then
  echo "configuration role $role does not match host role $installed_role" >&2
  exit 2
fi

exec 9>/run/lock/kamori-host-config.lock
flock -n 9 || { echo "another host configuration is active" >&2; exit 1; }

work_dir=$(mktemp -d /var/tmp/kamori-host-config.XXXXXX)
marker_temporary=""
install_temporary=""
cleanup() {
  if [[ -n "$marker_temporary" ]]; then
    rm -f "$marker_temporary"
  fi
  if [[ -n "$install_temporary" ]]; then
    rm -f "$install_temporary"
  fi
  find "$work_dir" -mindepth 1 -delete
  rmdir "$work_dir"
}
trap cleanup EXIT

payload="$work_dir/payload.b64"
archive="$work_dir/payload.tar.gz"
# Host configuration is intentionally small. A hard input bound prevents a
# compromised transport from filling the root filesystem before validation.
head -c 8388609 >"$payload"
if (( $(wc -c <"$payload") > 8388608 )); then
  echo "host configuration exceeds the 8 MiB limit" >&2
  exit 2
fi
base64 --decode "$payload" >"$archive"

while IFS= read -r entry; do
  if [[ -z "$entry" || "$entry" == /* || "$entry" == ".." || "$entry" == ../* || "$entry" == */../* ]]; then
    echo "host configuration contains an unsafe path" >&2
    exit 2
  fi
done < <(tar -tzf "$archive")

tar -xzf "$archive" -C "$work_dir" --no-same-owner
if [[ $(tr -d '\r\n' <"$work_dir/.kamori-role") != "$role" ]]; then
  echo "host configuration archive has the wrong role" >&2
  exit 2
fi
if find "$work_dir/root" -type l -o -type b -o -type c -o -type p -o -type s | grep -q .; then
  echo "host configuration may contain regular files and directories only" >&2
  exit 2
fi

restore_deploy_ssh_permissions() {
  chown deploy:deploy \
    /home/deploy \
    /home/deploy/.ssh \
    /home/deploy/.ssh/authorized_keys
  chmod 0755 /home/deploy
  chmod 0700 /home/deploy/.ssh
  chmod 0600 /home/deploy/.ssh/authorized_keys
}

# The previous installer copied its own pathname in place. Bash reads scripts
# incrementally, so truncating that live inode could make an otherwise valid
# configuration fail halfway through parsing. The stable installer uses a new
# pathname for the one-time transition and atomically renames every regular
# file from a temporary inode in the destination directory.
rm -f /usr/local/sbin/kamori-apply-host-config

# This invariant is repaired even when the incoming archive is unchanged. It
# keeps external ownership drift from locking out the restricted configuration
# identity while preserving the fast no-op path for services and role setup.
restore_deploy_ssh_permissions

install -d -o root -g root -m 0700 /var/lib/kamori
configuration_marker="/var/lib/kamori/host-configuration-${role}.sha256"
configuration_fingerprint=$(sha256sum "$archive" | awk '{print $1}')
installed_configuration_fingerprint=""
if [[ -r "$configuration_marker" ]]; then
  installed_configuration_fingerprint=$(tr -d '\r\n' <"$configuration_marker")
fi
if [[ "$installed_configuration_fingerprint" == "$configuration_fingerprint" ]]; then
  echo "${role} host configuration is already applied"
  exit 0
fi

# The archive is generated by Pulumi from an allowlisted set of repository
# assets and encrypted stack values. Install only validated regular files.
# Renaming within the destination filesystem is atomic and keeps a running
# installer or service executable attached to its original complete inode.
while IFS= read -r -d '' source; do
  relative_path=${source#"$work_dir/root/"}
  destination="/$relative_path"
  destination_directory=$(dirname "$destination")
  install -d -o root -g root "$destination_directory"
  install_temporary=$(mktemp "$destination_directory/.kamori-host-config.XXXXXX")
  cp -- "$source" "$install_temporary"
  chmod --reference="$source" "$install_temporary"
  chown root:root "$install_temporary"
  mv -fT "$install_temporary" "$destination"
  install_temporary=""
done < <(find "$work_dir/root" -type f -print0)

restore_deploy_ssh_permissions
sshd -t
systemctl daemon-reload
systemctl restart ssh.socket

case "$role" in
  app)
    /usr/local/sbin/kamori-repair-egress app
    chown 10001:10001 \
      /etc/kamori/cloud.env \
      /etc/kamori/secrets/opaque-server-setup \
      /etc/kamori/secrets/refresh-rotation-key \
      /etc/kamori/postgres-ca.crt \
      /etc/kamori/postgres-client.crt \
      /etc/kamori/postgres-client.key
    visudo -cf /etc/sudoers.d/kamori-deploy
    systemctl enable kamori-cloud.service
    if [[ -r /etc/kamori/release.env ]]; then
      systemctl restart kamori-cloud.service
    fi
    ;;
  ops)
    /usr/local/sbin/kamori-repair-egress ops
    docker compose --project-directory /opt/kamori/ops \
      --file /opt/kamori/ops/compose.yaml \
      --env-file /etc/kamori/ops.env config --quiet
    docker compose --project-directory /opt/kamori/ops \
      --file /opt/kamori/ops/compose.yaml \
      --env-file /etc/kamori/ops.env pull
    docker compose --project-directory /opt/kamori/ops \
      --file /opt/kamori/ops/compose.yaml \
      --env-file /etc/kamori/ops.env up -d --remove-orphans
    systemctl enable --now kamori-blob-replication.timer
    ;;
  db-primary)
    /usr/local/sbin/kamori-repair-egress db-primary
    /usr/local/lib/kamori/bootstrap-primary
    ;;
esac

marker_temporary=$(mktemp "/var/lib/kamori/.host-configuration-${role}.XXXXXX")
printf '%s\n' "$configuration_fingerprint" >"$marker_temporary"
chmod 0600 "$marker_temporary"
mv "$marker_temporary" "$configuration_marker"
marker_temporary=""

echo "applied ${role} host configuration"
