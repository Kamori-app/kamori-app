#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  exit 2
fi

role=$1
case "${SSH_ORIGINAL_COMMAND:-}" in
  "apply ${role}")
    exec sudo /usr/local/sbin/kamori-apply-host-config "$role"
    ;;
  "repair-egress ${role}")
    exec sudo /usr/local/sbin/kamori-repair-egress "$role"
    ;;
  *)
    echo "this identity may only configure the ${role} host" >&2
    exit 2
    ;;
esac
