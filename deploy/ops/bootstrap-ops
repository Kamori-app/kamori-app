#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "bootstrap-ops must run as root" >&2
  exit 1
fi

bundle_dir=${1:-.}
test -r /etc/kamori/ops.env
test -r /etc/kamori/secrets/metrics_token
install -d -m 0755 /opt/kamori/ops
install -m 0644 "$bundle_dir/compose.yaml" /opt/kamori/ops/compose.yaml
install -m 0644 "$bundle_dir/prometheus.yml" /opt/kamori/ops/prometheus.yml
install -m 0644 "$bundle_dir/alerts.yml" /opt/kamori/ops/alerts.yml
install -m 0644 "$bundle_dir/alertmanager.yml" /opt/kamori/ops/alertmanager.yml
install -m 0644 "$bundle_dir/grafana-datasource.yml" /opt/kamori/ops/grafana-datasource.yml
cd /opt/kamori/ops
docker compose --env-file /etc/kamori/ops.env config --quiet
docker compose --env-file /etc/kamori/ops.env pull
docker compose --env-file /etc/kamori/ops.env up -d --remove-orphans
