KAMORI_BIND_ADDR=0.0.0.0:8080
# Pulumi renders this from kamori:databasePassword and versioned topology.
KAMORI_DATABASE_URL=postgres://kamori_app:PULUMI_RENDERED_PASSWORD@10.42.0.21:5432/kamori?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt&sslcert=/run/secrets/postgres-client.crt&sslkey=/run/secrets/postgres-client.key
KAMORI_DATABASE_MAX_CONNECTIONS=20
# Pulumi renders this from kamori:valkeyPassword and versioned topology.
KAMORI_VALKEY_URL=redis://:PULUMI_RENDERED_PASSWORD@10.42.0.31:6379/0
KAMORI_VALKEY_KEY_PREFIX=kamori:beta:
KAMORI_VALKEY_TTL_SECONDS=300

KAMORI_JWT_SECRET=REPLACE_RANDOM_SECRET
KAMORI_JWT_ISSUER=https://api.kamori.app
KAMORI_JWT_AUDIENCE=kamori-clients
KAMORI_ACCESS_TOKEN_TTL_SECONDS=300
KAMORI_REFRESH_TOKEN_TTL_SECONDS=2592000
KAMORI_JWT_PREAUTH_TTL_SECONDS=300
KAMORI_JWT_ACCOUNT_RECOVERY_TTL_SECONDS=600
KAMORI_OPAQUE_SERVER_SETUP_FILE=/run/secrets/opaque-server-setup
KAMORI_ALLOW_EPHEMERAL_OPAQUE_SETUP=false
KAMORI_REFRESH_ROTATION_KEY_FILE=/run/secrets/refresh-rotation-key

KAMORI_WEBAUTHN_RP_ID=kamori.app
KAMORI_WEBAUTHN_RP_ORIGIN=https://app.kamori.app
KAMORI_WEBAUTHN_RP_NAME=Kamori
KAMORI_ADMIN_WEBAUTHN_RP_ORIGIN=https://admin.kamori.app
KAMORI_ADMIN_WEBAUTHN_RP_NAME=Kamori Admin
# Generate once with: openssl rand -base64 32
# Keep stable across every API node and every restart. Losing it locks operator TOTP auth.
KAMORI_ADMIN_TOTP_KEK=replace-with-base64-32-byte-key
# Generate a different random key for consumer TOTP seeds.
KAMORI_AUTH_TOTP_KEK=replace-with-another-base64-32-byte-key
KAMORI_ENABLE_TOTP=true

KAMORI_CORS_ALLOW_ORIGINS=https://app.kamori.app,https://admin.kamori.app,tauri://localhost
KAMORI_CORS_ALLOW_METHODS=GET,POST,DELETE,OPTIONS
KAMORI_CORS_ALLOW_HEADERS=authorization,content-type,accept,x-kamori-refresh-transport,x-kamori-csrf-token
KAMORI_CORS_ALLOW_CREDENTIALS=true
KAMORI_WEB_REFRESH_COOKIE_NAME=__Host-kamori_rt
KAMORI_WEB_CSRF_COOKIE_NAME=__Host-kamori_csrf
KAMORI_WEB_REFRESH_COOKIE_PATH=/
KAMORI_WEB_REFRESH_COOKIE_SECURE=true
KAMORI_WEB_REFRESH_COOKIE_SAMESITE=lax

# Registration stays closed until every release gate in the hosted-beta runbook passes.
KAMORI_REGISTRATION_ENABLED=false
KAMORI_BETA_ACCOUNT_LIMIT=1000
KAMORI_MAX_BLOB_BYTES=26214400
KAMORI_ACCOUNT_STORAGE_BYTES=5000000000
KAMORI_OWNER_MONTHLY_EGRESS_BYTES=10000000000
KAMORI_OWNER_ROLLING_24H_EGRESS_BYTES=2000000000
KAMORI_OWNER_CONCURRENT_BLOB_DOWNLOADS=2
KAMORI_BLOB_DOWNLOAD_BYTES_PER_SECOND=1250000
KAMORI_GLOBAL_NONESSENTIAL_EGRESS_STOP_BYTES=16000000000000
KAMORI_GLOBAL_EMERGENCY_EGRESS_BREAKER_BYTES=19000000000000

KAMORI_OBJECT_STORE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
KAMORI_OBJECT_STORE_REGION=eu-central-003
KAMORI_OBJECT_STORE_BUCKET=REPLACE_BUCKET
KAMORI_OBJECT_STORE_ACCESS_KEY_ID=REPLACE_BUCKET_SCOPED_KEY_ID
KAMORI_OBJECT_STORE_SECRET_ACCESS_KEY=REPLACE_BUCKET_SCOPED_APPLICATION_KEY
KAMORI_OBJECT_STORE_ALLOW_HTTP=false
KAMORI_OBJECT_STORE_VIRTUAL_HOSTED_STYLE=false
KAMORI_METRICS_BEARER_TOKEN=REPLACE_RANDOM_METRICS_SECRET

KAMORI_AUTH_RATE_LIMIT_PER_MINUTE=30
KAMORI_API_RATE_LIMIT_PER_MINUTE=1200
RUST_LOG=cloud_server=info,tower_http=warn
