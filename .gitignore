# ─────────────────────────────────────────────────────────────────────────────

# Flutter build outputs
apps/dav-bridge-mobile/build/
apps/dav-bridge-mobile/.dart_tool/
apps/dav-bridge-mobile/.flutter-plugins
apps/dav-bridge-mobile/.flutter-plugins-dependencies
apps/dav-bridge-mobile/.packages
apps/dav-bridge-mobile/.metadata
apps/dav-bridge-mobile/pubspec_overrides.yaml
apps/dav-bridge-mobile/.fvm/
apps/dav-bridge-mobile/.gitignore

# Flutter generated files (recreated by `flutter pub get`)
apps/dav-bridge-mobile/.pub-cache/

# Dart analysis server cache
apps/dav-bridge-mobile/.dart_tool/

# Android build artefacts
apps/dav-bridge-mobile/android/.gradle/
apps/dav-bridge-mobile/android/.kotlin/
apps/dav-bridge-mobile/android/.cxx/
apps/dav-bridge-mobile/android/**/externalNativeBuild/
apps/dav-bridge-mobile/android/app/build/
apps/dav-bridge-mobile/android/captures/
apps/dav-bridge-mobile/android/local.properties
apps/dav-bridge-mobile/android/key.properties
apps/dav-bridge-mobile/android/*.jks
apps/dav-bridge-mobile/android/*.keystore

# Android signing keys — NEVER commit
apps/dav-bridge-mobile/android/app/upload-keystore.jks
apps/dav-bridge-mobile/android/app/debug.keystore

# iOS build artefacts
apps/dav-bridge-mobile/ios/Pods/
apps/dav-bridge-mobile/ios/Flutter/Debug.xcconfig
apps/dav-bridge-mobile/ios/Flutter/Generated.xcconfig
apps/dav-bridge-mobile/ios/Flutter/app.flx
apps/dav-bridge-mobile/ios/Flutter/ephemeral/
apps/dav-bridge-mobile/ios/Flutter/flutter_assets/
apps/dav-bridge-mobile/ios/Flutter/flutter_export_environment.sh
apps/dav-bridge-mobile/ios/Runner.xcworkspace/xcshareddata/
apps/dav-bridge-mobile/ios/Runner/GeneratedPluginRegistrant.m
apps/dav-bridge-mobile/ios/Runner/GeneratedPluginRegistrant.h
apps/dav-bridge-mobile/ios/.symlinks/

# macOS Flutter desktop
apps/dav-bridge-mobile/macos/Pods/
apps/dav-bridge-mobile/macos/Flutter/GeneratedPluginRegistrant.swift
apps/dav-bridge-mobile/macos/Flutter/Generated.xcconfig
apps/dav-bridge-mobile/macos/Flutter/ephemeral/
apps/dav-bridge-mobile/macos/.symlinks/

# Unsupported Flutter targets in this repository (mobile app is Android + iOS)
apps/dav-bridge-mobile/macos/
apps/dav-bridge-mobile/linux/
apps/dav-bridge-mobile/windows/
apps/dav-bridge-mobile/web/

# Linux Flutter desktop
apps/dav-bridge-mobile/linux/flutter/generated_plugin_registrant.cc
apps/dav-bridge-mobile/linux/flutter/generated_plugin_registrant.h
apps/dav-bridge-mobile/linux/flutter/generated_plugins.cmake

# Windows Flutter desktop
apps/dav-bridge-mobile/windows/flutter/generated_plugin_registrant.cc
apps/dav-bridge-mobile/windows/flutter/generated_plugin_registrant.h
apps/dav-bridge-mobile/windows/flutter/generated_plugins.cmake

# flutter_rust_bridge v2 generated Dart bindings (regenerated by frb_codegen)
# These ARE generated code but are typically committed so that `flutter pub get`
# doesn't require the full Rust toolchain.
# Uncomment the lines below if you prefer to regenerate them in CI instead:
# apps/dav-bridge-mobile/lib/src/bridge/generated/

# frb_codegen C header (regenerated by `flutter_rust_bridge_codegen generate`)
apps/dav-bridge-mobile/ios/Runner/bridge_generated.h

# Flutter test coverage
apps/dav-bridge-mobile/coverage/


# ─────────────────────────────────────────────────────────────────────────────
# DOCKER / CONTAINER
# ─────────────────────────────────────────────────────────────────────────────

# Docker override files (local-only service config)
docker-compose.override.yml
docker-compose.override.yaml

# Docker build context temporaries
.dockerignore.local

# Local registry / image tarballs
*.tar
*.tar.gz
*.tar.xz
*.tar.bz2


