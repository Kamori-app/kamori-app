# ─────────────────────────────────────────────────────────────────────────────
# CI / BUILD TOOLING
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Actions local runner cache
.act/

# Vercel
.vercel/
.vercel

# Netlify
.netlify/

# Husky
# .husky/_/ is generated by `husky install` — do NOT ignore it.
# The actual hook scripts (.husky/pre-commit etc.) ARE committed.

# lint-staged cache
.lint-staged-cache/
.eslintcache
.stylelintcache

# Prettier cache
.prettier_cache/
.prettiercache

# TypeScript incremental build info
*.tsbuildinfo
**/*.tsbuildinfo

# cargo-generate templates
.cargo-generate/

# Changeset files (published changesets are deleted; pending ones are committed)
# .changeset/ — DO commit this directory; only ignore the lock file
.changeset/.lock


# ─────────────────────────────────────────────────────────────────────────────
# LOGS
# ─────────────────────────────────────────────────────────────────────────────

*.log
*.log.*
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Rust panic / crash dumps
core
core.*
crash.log


# ─────────────────────────────────────────────────────────────────────────────
# TEMPORARY / MISC
# ─────────────────────────────────────────────────────────────────────────────

# Generic temp files
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.patch

# Archive files accidentally left in the repo
*.zip
*.7z

# Profiling output
perf.data
perf.data.old
flamegraph.svg
flamegraph.html
*.folded

# Heap dumps
*.hprof

# Valgrind output
valgrind.out.*
massif.out.*

# macOS Simulator runtimes (Xcode)
*.simruntime/

# Node.js REPL history
.node_repl_history

# Optional REPL history for Rust (`evcxr`)
.evcxr_history

# Cargo home caches that should not be inside the repo
.cargo/registry/
.cargo/git/


# ─────────────────────────────────────────────────────────────────────────────
# EXPLICITLY COMMITTED (overrides above rules)
# These patterns override ignore rules for files that MUST be in VCS.
# ─────────────────────────────────────────────────────────────────────────────

# Cargo workspace lock (application binaries commit their lockfile)
!Cargo.lock

# pnpm lockfile
!pnpm-lock.yaml

# Husky hooks directory
!.husky/
!.husky/_/
!.husky/pre-commit
!.husky/commit-msg
!.husky/pre-push

# SQLx offline query cache (enables CI builds without a live DB)
!**/.sqlx/
!**/.sqlx/**

# VSCode recommended extensions (shared team config, no secrets)
!.vscode/extensions.json

# GitHub Actions workflows
!.github/
!.github/**

# Tauri icon assets (not build output — committed source)
!apps/dav-bridge-desktop/src-tauri/icons/

# Tauri capabilities (security policy — must be reviewed and committed)
!apps/dav-bridge-desktop/src-tauri/capabilities/

# flutter_rust_bridge generated bindings (committed for DX convenience)
!apps/dav-bridge-mobile/lib/src/rust/gen/
!apps/dav-bridge-mobile/lib/src/rust/gen/**
!packages/crypto-core-lib/src/frb_generated.rs
