# =============================================================================
# kamori-app — root .gitignore
#
# Covers all workspace members:
#   - Rust (cargo workspace: cloud-server, dav-bridge-desktop, crypto-core-lib)
#   - Tauri v2 desktop (src-tauri/)
#   - SvelteKit / Vite (web-app, dav-bridge-desktop frontend)
#   - Flutter + flutter_rust_bridge (dav-bridge-mobile)
#   - Turborepo + pnpm
#   - CI, editors, OS artefacts
#
# Rule of thumb:
#   - Committed:   source files, Cargo.lock, pnpm-lock.yaml, pubspec.lock
#   - Ignored:     build outputs, generated code, secrets, editor state
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# SECRETS & ENVIRONMENT FILES
# Never commit real credentials — only .example files are committed.
# ─────────────────────────────────────────────────────────────────────────────

.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test

# Pulumi state exports are recovery artifacts, not source configuration.
# Pulumi.<stack>.yaml remains commit-safe only while every secret uses `secure:`.
infra/pulumi-*-backup.json

# Local audit/design notes intentionally kept outside version control.
AUDIT_FOLLOWUPS.local.md

# Allow example / template env files
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Key material & certificates (never in VCS)
*.pem
*.key
*.crt
*.p12
*.pfx
*.der
*.cer
*.csr
*.keystore
*.jks

# macOS Keychain export
*.p8


# ─────────────────────────────────────────────────────────────────────────────
# RUST / CARGO
# ─────────────────────────────────────────────────────────────────────────────

# Cargo build artefacts (workspace-level and per-crate)
/target/
**/target/

# Cargo.lock is committed in application crates (cloud-server, bins) but NOT
# in library crates (crypto-core-lib).  We commit it at the workspace root.
# Per-crate Cargo.lock files (inside packages/) are ignored.
packages/**/Cargo.lock

# rustfmt backup files
**/*.rs.bk

# Cargo mutants output
**/mutants.out*/
**/mutants.out/

# llvm-cov / coverage output
**/lcov.info
**/coverage/
**/coverage.json
**/*.profraw
**/*.profdata

# sqlx offline query cache — COMMITTED so CI can build without a live DB.
# Uncomment the line below only if you want to re-run sqlx prepare every build.
# **/.sqlx/

# cargo-audit / cargo-deny reports
audit.json
deny-report.json


# ─────────────────────────────────────────────────────────────────────────────
# WASM — wasm-pack output
# The pkg/ directory is generated by `wasm-pack build` / `pnpm wasm:build`.
# It is rebuilt from source on every developer machine and in CI.
# ─────────────────────────────────────────────────────────────────────────────

packages/crypto-core-lib/pkg/
packages/crypto-core-lib/target-wasm/

# wasm-pack temporary files
.wasm-pack-*


# ─────────────────────────────────────────────────────────────────────────────
# NODE.JS / PNPM / TURBOREPO
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies — installed by `pnpm install`
node_modules/
**/node_modules/

# pnpm virtual store (content-addressable store lives outside the repo by default,
# but the .pnpm/ symlink tree inside node_modules is covered above)
.pnpm-store/
.pnpm-debug.log*

# npm / yarn leftovers (not used, but guard against accidental installs)
package-lock.json
yarn.lock
.yarn/

# Turborepo cache
.turbo/
**/.turbo/

# Turbo daemon socket
.turbo-daemon.sock


# ─────────────────────────────────────────────────────────────────────────────
# SVELTEKIT / VITE
# ─────────────────────────────────────────────────────────────────────────────

# SvelteKit generated files (re-created by `svelte-kit sync` / `vite dev`)
.svelte-kit/
**/.svelte-kit/
**/.svelte-check/

# Vite build outputs
**/build/
**/dist/

# Tauri validates frontendDist during Rust-only checks on a clean checkout.
!apps/dav-bridge-desktop/dist/
apps/dav-bridge-desktop/dist/*
!apps/dav-bridge-desktop/dist/.gitkeep

# Vite cache
**/.vite/

# Local acceptance runtime secrets, databases, and browser artifacts
tests/acceptance/.runtime/
tests/acceptance/artifacts/
**/vite.config.js.timestamp-*
**/vite.config.ts.timestamp-*

# Vitest / testing
**/coverage/
**/.nyc_output/
**/playwright-report/
**/test-results/
**/blob-reporter/

# Playwright browser binaries (downloaded on `pnpm exec playwright install`)
**/playwright/.local-browsers/
**/playwright/.local-chromium/


# ─────────────────────────────────────────────────────────────────────────────
# TAURI v2
# ─────────────────────────────────────────────────────────────────────────────

# Tauri generated bindings / capabilities helper files
apps/dav-bridge-desktop/src-tauri/gen/
apps/dav-bridge-desktop/src-tauri/target/

# Tauri bundle output (platform installers: .dmg, .exe, .deb, .AppImage, etc.)
apps/dav-bridge-desktop/src-tauri/target/release/bundle/

# Tauri signing keys (NEVER commit)
**/tauri-signing-private-key*
**/tauri.key
**/tauri.key.pub

# WiX / NSIS installer build artefacts
**/*.wixobj
**/*.wixpdb
**/*.msi


